{
    "name": "review-automation/magento2-reviews",
    "description": "Configurable Magento 2 review requests, customer feedback, product review emails and historical-order campaigns.",
    "type": "magento2-module",
    "license": "MIT",
    "keywords": [
        "magento2",
        "reviews",
        "review-automation",
        "customer-feedback"
    ],
    "require": {
        "php": "^8.1",
        "magento/framework": "^103.0",
        "magento/module-backend": "^102.0",
        "magento/module-sales": "^103.0",
        "magento/module-catalog": "^104.0",
        "magento/module-customer": "^103.0",
        "magento/module-store": "^101.0",
        "magento/module-config": "^101.0",
        "magento/module-email": "^101.0",
        "magento/module-review": "^100.0",
        "magento/module-ui": "^101.0",
        "symfony/console": "^5.4 || ^6.4 || ^7.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "ReviewAutomation\\Reviews\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ReviewAutomation\\Reviews\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php tests/run.php",
        "check": "python3 tools/check.py"
    },
    "archive": {
        "exclude": [
            "/tests",
            "/tools",
            "/.github",
            "/.gitignore"
        ]
    }
}
