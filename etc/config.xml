<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <reviewautomation_review_automation>
            <filters>
                <allowed_store_ids></allowed_store_ids>
                <max_order_age_days>60</max_order_age_days>
            </filters>
            <general>
                <enabled>0</enabled>
                <email1_delay_days>7</email1_delay_days>
                <email1_reminder_delay_days>3</email1_reminder_delay_days>
                <email2_delay_hours>96</email2_delay_hours>
                <product_review_delay_days>14</product_review_delay_days>
                <token_expiry_days>60</token_expiry_days>
                <sender_name></sender_name>
                <sender_email></sender_email>
                <admin_notification_email></admin_notification_email>
                <satisfaction_email_template>reviewautomation_review_satisfaction_check</satisfaction_email_template>
                <satisfaction_reminder_email_template>reviewautomation_review_satisfaction_reminder</satisfaction_reminder_email_template>
                <review_request_email_template>reviewautomation_review_request</review_request_email_template>
                <product_review_request_email_template>reviewautomation_product_review_request</product_review_request_email_template>
                <admin_notification_email_template>reviewautomation_review_admin_feedback_notification</admin_notification_email_template>
                <reply_to_email></reply_to_email>
                <send_window_enabled>1</send_window_enabled>
                <send_window_start_hour>8</send_window_start_hour>
                <send_window_end_hour>19</send_window_end_hour>
                <email2_nudge_enabled>1</email2_nudge_enabled>
                <email2_nudge_delay_days>5</email2_nudge_delay_days>
                <review_request_nudge_email_template>reviewautomation_review_request_nudge</review_request_nudge_email_template>
            </general>
            <branding>
                <name></name>
                <accent_color>#2563eb</accent_color>
                <logo_url></logo_url>
            </branding>
            <platforms>
                <google_url></google_url>
                <trustpilot_url></trustpilot_url>
                <primary_platform>both</primary_platform>
                <gmail_targeting_enabled>0</gmail_targeting_enabled>
            </platforms>
            <suppression>
                <suppress_refunded>1</suppress_refunded>
                <suppress_cancelled>1</suppress_cancelled>
                <min_order_value>0.00</min_order_value>
                <max_emails_per_month>1</max_emails_per_month>
            </suppression>
        </reviewautomation_review_automation>
    </default>
</config>
