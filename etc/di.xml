<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
        Register grid data sources. The <item name="..."> must match the
        dataSource name attribute in each UI component XML exactly.
    -->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="reviewautomation_review_queue_listing_data_source" xsi:type="string">ReviewAutomation\Reviews\Model\ResourceModel\Queue\Grid\Collection</item>
                <item name="reviewautomation_review_feedback_listing_data_source" xsi:type="string">ReviewAutomation\Reviews\Model\ResourceModel\Feedback\Grid\Collection</item>
                <item name="reviewautomation_review_unsubscribe_listing_data_source" xsi:type="string">ReviewAutomation\Reviews\Model\ResourceModel\Unsubscribe\Grid\Collection</item>
            </argument>
        </arguments>
    </type>

    <!--
        Queue grid collection — redirect to FilteredCollection, which extends
        SearchResult and applies the Order Filters (allowed_store_ids +
        max_order_age_days) so the admin preview matches cron behaviour.
        The CollectionFactory mapping above still uses the Grid\Collection
        classname; the preference resolves that request to the concrete class.
    -->
    <preference for="ReviewAutomation\Reviews\Model\ResourceModel\Queue\Grid\Collection"
                type="ReviewAutomation\Reviews\Model\ResourceModel\Queue\Grid\FilteredCollection"/>

    <!--
        Feedback grid collection — plain virtualType (no filters needed).
    -->
    <virtualType name="ReviewAutomation\Reviews\Model\ResourceModel\Feedback\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">reviewautomation_review_feedback</argument>
            <argument name="resourceModel"
                      xsi:type="string">ReviewAutomation\Reviews\Model\ResourceModel\Feedback</argument>
        </arguments>
    </virtualType>

    <!-- Unsubscribe (suppression list) admin grid collection. -->
    <virtualType name="ReviewAutomation\Reviews\Model\ResourceModel\Unsubscribe\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">reviewautomation_review_unsubscribe</argument>
            <argument name="resourceModel"
                      xsi:type="string">ReviewAutomation\Reviews\Model\ResourceModel\Unsubscribe</argument>
        </arguments>
    </virtualType>
    <type name="Magento\Framework\Console\CommandList">
        <arguments><argument name="commands" xsi:type="array">
            <item name="reviewautomation_import_legacy" xsi:type="object">ReviewAutomation\Reviews\Console\Command\ImportLegacy</item>
        </argument></arguments>
    </type>
</config>
