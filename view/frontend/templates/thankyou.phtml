<?php
/** @var \ReviewAutomation\Reviews\Block\Thankyou $block */
$showGoogle = $block->shouldShowGoogle();
$showTrustpilot = $block->shouldShowTrustpilot();
?>
<?php /** @var \Magento\Framework\View\Element\Template $block */ ?>
<section class="ra-review" aria-labelledby="ra-title" style="--review-accent:<?= $block->escapeHtmlAttr($block->getData('branding')->getColor()) ?>">
    <div class="ra-card">
        <p class="ra-eyebrow"><?= $block->escapeHtml(__('Your feedback')) ?></p>
        <h1 id="ra-title"><?= $block->escapeHtml(__('Share your experience')) ?></h1>
        <p><?= $block->escapeHtml(__('Your honest review helps other customers choose with confidence. We welcome every point of view.')) ?></p>
        <div class="ra-actions">
            <?php if ($showGoogle): ?>
            <a class="ra-button" href="<?= $block->escapeUrl($block->getGoogleCtaUrl()) ?>" target="_blank" rel="noopener noreferrer"><?= $block->escapeHtml(__('Review us on Google')) ?></a>
            <?php endif; ?>
            <?php if ($showTrustpilot): ?>
            <a class="ra-button" href="<?= $block->escapeUrl($block->getTrustpilotCtaUrl()) ?>" target="_blank" rel="noopener noreferrer"><?= $block->escapeHtml(__('Review us on Trustpilot')) ?></a>
            <?php endif; ?>
        </div>
        <?php if (!$showGoogle && !$showTrustpilot): ?>
        <p class="ra-muted"><?= $block->escapeHtml(__('Thank you for your interest. Please contact our team if you’d like to share feedback.')) ?></p>
        <?php endif; ?>
        <hr class="ra-divider"><p class="ra-small"><a class="ra-link" href="<?= $block->escapeUrl($block->getBaseUrl()) ?>"><?= $block->escapeHtml(__('Continue shopping')) ?></a></p>
    </div>
</section>
