<?php /** @var \Magento\Framework\View\Element\Template $block */ ?>
<?php if ($block->getData('branding')->getLogoUrl()): ?>
    <p style="text-align:center"><img style="max-width:220px;max-height:80px" src="<?= $block->escapeUrl($block->getData('branding')->getLogoUrl()) ?>" alt="<?= $block->escapeHtmlAttr($block->getData('branding')->getName()) ?>"></p>
<?php endif; ?>
<div style="max-width:640px;margin:40px auto">
    <h1><?= $block->escapeHtml($block->getData('branding')->getName()) ?></h1>
    <p><?= $block->escapeHtml(__('Confirm below to stop receiving review emails. This preference applies across our store views.')) ?></p>
    <form method="post" action="<?= $block->escapeUrl($block->getUrl('reviewautomation_reviews/unsubscribe/save')) ?>">
        <?= $block->getBlockHtml('formkey') ?>
        <input type="hidden" name="token" value="<?= $block->escapeHtmlAttr((string) $block->getRequest()->getParam('token')) ?>">
        <button type="submit" class="action primary"><?= $block->escapeHtml(__('Unsubscribe')) ?></button>
    </form>
</div>
