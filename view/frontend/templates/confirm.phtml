<?php /** @var \Magento\Framework\View\Element\Template $block */ ?>
<section class="ra-review" aria-labelledby="ra-title" style="--review-accent:<?= $block->escapeHtmlAttr($block->getData('branding')->getColor()) ?>">
    <div class="ra-card">
        <p class="ra-eyebrow"><?= $block->escapeHtml(__('Your feedback')) ?></p>
        <h1 id="ra-title"><?= $block->escapeHtml(__('Share your feedback')) ?></h1>
        <?php $positive = $block->getRequest()->getParam('sentiment') === 'happy'; ?>
        <p><?= $block->escapeHtml($positive ? __('Let us know that everything went well. You can also share your experience in a public review.') : __('If something wasn’t right, we’d like to help. Continue to tell our team what happened.')) ?></p>
        <form method="post" action="<?= $block->escapeUrl($block->getUrl('reviewautomation_reviews/response/submit')) ?>">
            <?= $block->getBlockHtml('formkey') ?>
            <input type="hidden" name="token" value="<?= $block->escapeHtmlAttr((string) $block->getRequest()->getParam('token')) ?>">
            <input type="hidden" name="sentiment" value="<?= $block->escapeHtmlAttr((string) $block->getRequest()->getParam('sentiment')) ?>">
            <button type="submit" class="ra-button"><?= $block->escapeHtml(__('Continue')) ?></button>
        </form>
        <hr class="ra-divider"><p class="ra-small"><a class="ra-link" href="<?= $block->escapeUrl($block->getUrl('reviewautomation_reviews/response/thankyou', ['token' => (string) $block->getRequest()->getParam('token')])) ?>"><?= $block->escapeHtml(__('Leave a public review')) ?></a></p>
    </div>
</section>
