<script>
// Minimal vanilla JS for star-rating interactivity — no RequireJS dependency.
(function () {
    var container = document.getElementById('reviewautomation-star-rating');
    if (!container) return;
    var stars = container.querySelectorAll('.reviewautomation-star');
    var radios = container.querySelectorAll('input[type="radio"]');
    var selected = 0;

    function highlight(upTo) {
        stars.forEach(function (s, idx) {
            s.style.color = idx < upTo ? '<?= $block->escapeHtmlAttr($block->getData('branding')->getColor()) ?>' : '#cccccc';
        });
    }

    stars.forEach(function (star, idx) {
        star.addEventListener('mouseenter', function () { highlight(idx + 1); });
        star.addEventListener('click', function () {
            selected = idx + 1;
            radios[idx].checked = true;
            highlight(selected);
        });
    });

    container.addEventListener('mouseleave', function () { highlight(selected); });
})();
</script>
