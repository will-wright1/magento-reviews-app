<?php /** @var \ReviewAutomation\Reviews\Block\FeedbackForm $block */ ?>
<?php /** @var \Magento\Framework\View\Element\Template $block */ ?>
<section class="ra-review" aria-labelledby="ra-title" style="--review-accent:<?= $block->escapeHtmlAttr($block->getData('branding')->getColor()) ?>">
    <div class="ra-card">
        <p class="ra-eyebrow"><?= $block->escapeHtml(__('Your feedback')) ?></p>
        <h1 id="ra-title"><?= $block->escapeHtml(__('Let’s put things right')) ?></h1>
        <p><?= $block->escapeHtml(__('Hi %1, please tell us what happened so our team can help.', trim($block->getCustomerFirstname()))) ?></p>
        <?php if ($block->getOrderIncrementId()): ?>
        <p class="ra-small"><?= $block->escapeHtml(__('Order #%1', $block->getOrderIncrementId())) ?></p>
        <?php endif; ?>
        <form action="<?= $block->escapeUrl($block->getFormAction()) ?>" method="post" id="reviewautomation-feedback-form">
            <?= $block->getBlockHtml('formkey') ?>
            <input type="hidden" name="token" value="<?= $block->escapeHtmlAttr($block->getToken()) ?>">
            <input type="hidden" name="form_token" value="<?= $block->escapeHtmlAttr($block->getTimestampToken()) ?>">
            <div class="ra-honeypot" aria-hidden="true">
                <label for="website"><?= $block->escapeHtml(__('Leave this empty')) ?></label>
                <input type="text" name="website" id="website" value="" tabindex="-1" autocomplete="off">
            </div>
            <fieldset>
                <legend><?= $block->escapeHtml(__('How would you rate your experience? (optional)')) ?></legend>
                <div class="ra-ratings">
                    <?php for ($i = 1; $i <= 5; $i++): ?>
                    <label><input type="radio" name="rating" value="<?= (int) $i ?>"><span><?= $block->escapeHtml(__('%1 out of 5', $i)) ?></span></label>
                    <?php endfor; ?>
                </div>
            </fieldset>
            <div class="ra-field">
                <label for="feedback_text"><?= $block->escapeHtml(__('Tell us what happened')) ?></label>
                <textarea name="feedback_text" id="feedback_text" rows="5" maxlength="10000" required placeholder="<?= $block->escapeHtmlAttr(__('Include any details that will help us understand the problem.')) ?>"></textarea>
            </div>
            <button type="submit" class="ra-button"><?= $block->escapeHtml(__('Send feedback to the team')) ?></button>
            <p class="ra-small" style="margin-top:16px"><?= $block->escapeHtml(__('Your comments are shared privately with our team and won’t be posted publicly.')) ?></p>
        </form>
        <hr class="ra-divider"><p class="ra-small"><a class="ra-link" href="<?= $block->escapeUrl($block->getUrl('reviewautomation_reviews/response/thankyou', ['token' => (string) $block->getRequest()->getParam('token')])) ?>"><?= $block->escapeHtml(__('Leave a public review')) ?></a></p>
    </div>
</section>
