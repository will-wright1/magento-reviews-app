<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd"
      layout="1column">
    <update handle="reviewautomation_reviews_shared"/>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="reviewautomation.review.expired"
                   template="ReviewAutomation_Reviews::expired.phtml"
                   cacheable="false">
                <arguments><argument name="branding" xsi:type="object">ReviewAutomation\Reviews\ViewModel\Branding</argument></arguments>
            </block>
        </referenceContainer>
    </body>
</page>
