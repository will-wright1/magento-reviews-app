<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd"
      layout="1column">
    <body>
        <referenceContainer name="content">
            <block class="ReviewAutomation\Reviews\Block\FeedbackForm"
                   name="reviewautomation.review.feedback"
                   template="ReviewAutomation_Reviews::feedback.phtml"
                   cacheable="false">
                <arguments><argument name="branding" xsi:type="object">ReviewAutomation\Reviews\ViewModel\Branding</argument></arguments>
            </block>
        </referenceContainer>
    </body>
</page>
