                                  style="width:100%;"><?= $block->escapeHtml($feedback->getAdminNotes()) ?></textarea>
                    </div>
                </div>
            </fieldset>

            <div class="admin__page-actions" style="margin-top:16px;">
                <button type="submit" class="action-primary" title="<?= $block->escapeHtmlAttr(__('Save')) ?>">
                    <span><?= $block->escapeHtml(__('Save')) ?></span>
                </button>
                <a href="<?= /* @noEscape */ $backUrl ?>" class="action-secondary">
                    <span><?= $block->escapeHtml(__('Cancel')) ?></span>
                </a>
            </div>
        </form>
